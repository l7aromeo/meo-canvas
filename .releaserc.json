{
  "branches": [
    "main",
    {
      "name": "beta",
      "prerelease": true,
      "channel": "beta"
    },
    {
      "name": "alpha",
      "prerelease": true,
      "channel": "alpha"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      {
        "npmPublish": true,
        "tarballDir": "release"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "mkdir -p release && tar -czf release/meonode-canvas-${nextRelease.version}.tar.gz dist/"
      }
    ],
    [
      "@semantic-release/gitlab",
      {
        "gitlabUrl": "https://gitlab.com",
        "assets": [
          {
            "path": "release/*.tgz",
            "label": "npm package"
          },
          {
            "path": "release/*.tar.gz",
            "label": "Distribution (tar.gz)"
          }
        ]
      }
    ]
  ]
}