{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "./node_modules/@semantic-release/npm",
      {
        "npmPublish": true,
        "tarballDir": "release"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "mkdir -p release && tar -czf release/meo-canvas-${nextRelease.version}.tar.gz dist/",
        "successCmd": "test -n \"$GITHUB_OUTPUT\" && echo published=true >> \"$GITHUB_OUTPUT\" || true"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release/*.tgz",
            "label": "npm package"
          },
          {
            "path": "release/*.tar.gz",
            "label": "Distribution (tar.gz)"
          }
        ],
        "failComment": false,
        "failTitle": false
      }
    ]
  ]
}
