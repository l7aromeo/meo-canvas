{
  "branches": [
    "main",
    {
      "name": "beta",
      "prerelease": true,
      "channel": "beta"
    },
    {
      "name": "alpha",
      "prerelease": true,
      "channel": "alpha"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "# Changelog\n\nEvery release, newest first. Generated from the commit messages merged into `main`, `beta`, and\n`alpha` — see CONTRIBUTING.md for what a commit message decides."
      }
    ],
    [
      "./node_modules/@semantic-release/npm",
      {
        "npmPublish": true,
        "tarballDir": "release"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "mkdir -p release && tar -czf release/meo-canvas-${nextRelease.version}.tar.gz dist/"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release/*.tgz",
            "label": "npm package"
          },
          {
            "path": "release/*.tar.gz",
            "label": "Distribution (tar.gz)"
          }
        ],
        "failComment": false,
        "failTitle": false
      }
    ]
  ]
}
