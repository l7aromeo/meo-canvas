{
  "compilerOptions": {
    "types": ["node", "jest"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "dist",
    "importHelpers": true,
    "isolatedModules": true
  },
  "include": ["src", "scripts", "tests"]
}
