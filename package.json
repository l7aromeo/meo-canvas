{
  "name": "@meonode/canvas",
  "version": "1.0.0",
  "description": "A declarative, component-based library for server-side canvas image generation. Write complex visuals with simple functions, similar to the composition style of @meonode/ui.",
  "keywords": [
    "canvas",
    "server-side",
    "image-generation",
    "declarative",
    "component-based",
    "skia-canvas",
    "yoga-layout",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ukasyah Rahmatullah Zada",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/meonode/canvas.git"
  },
  "homepage": "https://gitlab.com/meonode/canvas#readme",
  "bugs": {
    "url": "https://gitlab.com/meonode/canvas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && rollup -c --bundleConfigAsCjs && tsc-alias -p tsconfig.esm.json && tsc-alias -p tsconfig.cjs.json",
    "test": "node --no-experimental-webstorage --experimental-vm-modules $(yarn bin jest)",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --fix",
    "format": "prettier --write .",
    "generate:samples": "npx tsx scripts/generate_sample_charts.ts && npx tsx scripts/generate_sample_grids.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.3.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/gitlab": "^13.3.2",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "yarn@4.11.0",
  "dependencies": {
    "file-type": "^21.3.1",
    "lodash-es": "^4.17.23",
    "sharp": "^0.34.5",
    "skia-canvas": "^3.0.8",
    "tinycolor2": "^1.6.0",
    "tslib": "^2.8.1",
    "yoga-layout": "^3.2.1"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md"
  ]
}
