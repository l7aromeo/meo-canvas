{
  "name": "meo-canvas",
  "version": "1.0.0",
  "description": "A declarative, component-based library for server-side canvas image generation. Write complex visuals with simple functions, similar to the composition style of @meonode/ui.",
  "keywords": [
    "canvas",
    "server-side",
    "image-generation",
    "declarative",
    "component-based",
    "skia-canvas",
    "yoga-layout",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "Ukasyah Rahmatullah Zada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-canvas.git"
  },
  "homepage": "https://github.com/l7aromeo/meo-canvas#readme",
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-canvas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun -e \"fs.rmSync('./dist', {recursive:true, force:true})\" && rollup -c --bundleConfigAsCjs && bun scripts/rewrite-dts-aliases.ts",
    "test": "vitest run --coverage",
    "test:ci": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --fix && bun run typecheck",
    "format": "prettier --write .",
    "generate:samples": "bun run typecheck && bunx tsx scripts/generate_sample_charts.ts && bunx tsx scripts/generate_sample_grids.ts && bunx tsx scripts/generate_sample_nested_grids.ts && bunx tsx scripts/generate_sample_animated_card.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "semantic-release": "25.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "file-type": "^22.0.0",
    "meo-skia-canvas": "^5.2.0",
    "tslib": "^2.8.1",
    "yoga-layout": "^3.2.1"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md"
  ]
}
