# The image the musl Linux addons are built in. musl versions no symbols, so
# these targets carry no `floors` in `TARGETS` and loading the binary is the
# whole evidence. Skia is downloaded, as on glibc: `patched-skia` refuses to
# compile it, and meo-skia-canvas publishes the musl archives it links.

# `musllinux_1_2_*` is PyPA's Alpine 3.22 with gcc, g++ and cmake, an `ARG` so
# one file serves both architectures. Alpine uses `lib`, not `lib64`, which
# `install-fontlibs.sh` takes as `LIBDIR`.
ARG BASE=quay.io/pypa/musllinux_1_2_x86_64
FROM ${BASE}

# Alpine's names for what the glibc image gets from dnf; `nasm` is x86-only, an
# `ARG` so aarch64 shares this file. libaom's cmake stops without `perl`, which
# autoconf brings anyway; without `fortify-headers` gcc's `_FORTIFY_SOURCE` has
# no musl wrappers, and fontconfig builds without overflow checks, silently.
ARG ASSEMBLER=nasm
RUN apk add --no-cache \
      ${ASSEMBLER} gperf ninja-build meson bash curl tar xz \
      linux-headers musl-dev perl fortify-headers

# Identical to the glibc image apart from `LIBDIR=lib`. The static font
# libraries matter more here: an Alpine image is even less likely than slim
# Debian to carry fontconfig.
COPY install-fontlibs.sh /opt/install-fontlibs.sh
RUN LIBDIR=lib bash /opt/install-fontlibs.sh && rm -f /opt/install-fontlibs.sh

ENV PKG_CONFIG_ALL_STATIC=1

# The same `g++` linker as the glibc image, since `cc` drops
# `-static-libstdc++`. Alpine has one libstdc++, so here it only means less of
# it must be present at runtime.

# `-crt-static` or there is no addon: Rust's musl targets default to
# `crt-static`, which "cannot produce cdylib". Off, the addon is a dynamic `.so`
# against Alpine's musl, like every other target.
ENV RUSTFLAGS="-C linker=g++ -C link-arg=-static-libstdc++ -C target-feature=-crt-static"

ARG RUST=1.98.0
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST"
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src
