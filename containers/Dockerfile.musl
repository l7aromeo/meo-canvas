# The image the musl Linux addons are built in. musl versions no symbols, so
# these targets carry no `floors` in `TARGETS` and loading the binary is the
# whole evidence. rust-skia has no prebuilt Skia for musl, so this image
# compiles all of it, and the toolchain blocks below have no glibc counterpart.

# `musllinux_1_2_*` is PyPA's Alpine 3.22 with gcc, g++ and cmake, an `ARG` so
# one file serves both architectures. Alpine uses `lib`, not `lib64`, which
# `install-fontlibs.sh` takes as `LIBDIR`.
ARG BASE=quay.io/pypa/musllinux_1_2_x86_64
FROM ${BASE}

# apk rather than dnf, with Alpine's package names. `nasm` is x86-only as in the
# glibc image, and the same `ARG` keeps an aarch64 target from forking this
# file.
ARG ASSEMBLER=nasm
RUN apk add --no-cache \
      ${ASSEMBLER} gperf ninja-build meson bash curl tar xz \
      linux-headers musl-dev python3 perl \
      gn clang clang-dev llvm llvm-dev \
      git

# Skia's `gn` comes from Alpine: skia-bindings downloads, or falls back to, a
# glibc x86_64 `gn` that cannot run on musl. The build then panics in
# `config.rs` with an empty message and a missing glibc loader, naming neither
# gn nor musl. `meo-skia-canvas` does the same.
ENV GN_EXE=gn \
    SKIA_GN_COMMAND=/usr/bin/gn \
    SKIA_NINJA_COMMAND=/usr/bin/ninja

# bindgen needs `libclang.so`, which Alpine ships in `clang-dev`, not `clang`;
# without it Skia compiles and then panics "Unable to find libclang". `git` is
# above because Skia's `git-sync-deps` needs it. Neither arises on glibc, which
# takes rust-skia's prebuilt Skia and bindings.
ENV LIBCLANG_PATH=/usr/lib/llvm20/lib

# clang finds GCC by the target triple, and `libaom-sys` passes the Rust one,
# `<arch>-unknown-linux-musl`; Alpine's GCC is under `<arch>-alpine-linux-musl`,
# so C fails on `crtbeginS.o` and C++ on `cstdint`. The config names the GCC
# directory holding both, chosen by contents, not version.

# The config goes beside the clang binary, since this clang does not read
# `/etc/clang`. The two compiles at the end fail the image build here, rather
# than thirty minutes into Skia on a missing header.
RUN ARCH="$(uname -m)" && TRIPLE="${ARCH}-alpine-linux-musl" && \
    GCC_DIR="" && \
    for dir in /usr/lib/gcc/"$TRIPLE"/*/; do \
      version="$(basename "$dir")"; \
      if [ -f "${dir}crtbeginS.o" ] && [ -d "/usr/include/c++/${version}/${TRIPLE}" ]; then \
        GCC_DIR="${dir%/}"; \
      fi; \
    done && \
    test -n "$GCC_DIR" && \
    CLANG_DIR="$(dirname "$(readlink -f "$(which clang)")")" && \
    printf -- '--gcc-install-dir=%s\n' "$GCC_DIR" \
      | tee "$CLANG_DIR/clang++.cfg" > "$CLANG_DIR/clang.cfg" && \
    printf 'int main(){ return 0; }\n' > /tmp/t.c && \
    printf '#include <cstdint>\n#include <vector>\nint main(){ std::vector<int> v; return (int)v.size(); }\n' > /tmp/t.cc && \
    clang --target="${ARCH}-unknown-linux-musl" /tmp/t.c -o /tmp/t && \
    clang++ --target="${ARCH}-unknown-linux-musl" /tmp/t.cc -o /tmp/txx && \
    rm -f /tmp/t.c /tmp/t.cc /tmp/t /tmp/txx && \
    echo "clang compiles and links C and C++ under the rust triple: ok"

# Identical to the glibc image apart from `LIBDIR=lib`. The static font
# libraries matter more here: an Alpine image is even less likely than slim
# Debian to carry fontconfig.
COPY install-fontlibs.sh /opt/install-fontlibs.sh
RUN LIBDIR=lib bash /opt/install-fontlibs.sh && rm -f /opt/install-fontlibs.sh

ENV PKG_CONFIG_ALL_STATIC=1

# The same `g++` linker as the glibc image, since `cc` drops
# `-static-libstdc++`. Alpine has one libstdc++, so here it only means less of
# it must be present at runtime.

# `-crt-static` or there is no addon: Rust's musl targets default to
# `crt-static`, which "cannot produce cdylib". Off, the addon is a dynamic `.so`
# against Alpine's musl, like every other target.
ENV RUSTFLAGS="-C linker=g++ -C link-arg=-static-libstdc++ -C target-feature=-crt-static"

ARG RUST=1.98.0
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST"
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src
