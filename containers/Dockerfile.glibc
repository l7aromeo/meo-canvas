# The image the glibc Linux addons are built in. The build base is the glibc
# floor, since a binary cannot link against symbol versions its sysroot lacks:
# built on `ubuntu-latest` the addon needed GLIBC_2.35 and failed on Rocky 9.
# `manylinux_2_28` is AlmaLinux 8.10, glibc 2.28, with GCC 14 and cmake.

# The base is an `ARG` so one file serves both architectures: the x86_64 and
# aarch64 images share a distribution and glibc.
ARG BASE=quay.io/pypa/manylinux_2_28_x86_64
FROM ${BASE}

# `nasm` is libaom's, which assembles its x86 paths; on aarch64 libaom compiles
# NEON intrinsics and needs none, measured, so `--build-arg ASSEMBLER=` builds
# that image from this file. `gperf`, `ninja-build` and meson build fontconfig;
# EL8 ships meson 0.58, and a current one comes from pip.
ARG ASSEMBLER=nasm
RUN dnf -y install --setopt=install_weak_deps=False \
      ${ASSEMBLER} gperf ninja-build make \
 && dnf clean all \
 && python3 -m venv /opt/meson \
 && /opt/meson/bin/pip install --no-cache-dir meson
ENV PATH="/opt/meson/bin:${PATH}"

# The font libraries, built static with no shared object: rust-skia links the
# system freetype and fontconfig, whose shared objects no target image carries,
# `node:22-slim` included. The distribution's archives drag in `libexpat`,
# `libbz2`, `libpng16` and `libbrotlidec`; built here, they take none but expat.
COPY install-fontlibs.sh /opt/install-fontlibs.sh
RUN bash /opt/install-fontlibs.sh && rm -f /opt/install-fontlibs.sh

# `--static` on the probe, so pkg-config hands rust-skia the transitive list
# rather than just the two names. Without it the link fails on fontconfig's own
# undefined references -- measured, `XML_GetCurrentLineNumber` first.
ENV PKG_CONFIG_ALL_STATIC=1

# `-static-libstdc++` defines 396 `std::` symbols in the binary, but rust-skia's
# unconditional `-lstdc++` keeps `NEEDED libstdc++.so.6`. What the flag buys is
# the residue's version: GLIBCXX_3.4.21, GCC 5.1's, under AlmaLinux 8's 3.4.25.

# rustc links through `cc`, which drops `-static-libstdc++` silently, so the
# linker is `g++`. Without it meo-skia-canvas shipped a binary under every
# GLIBCXX ceiling that failed to load on `_M_replace_cold`, a GCC 12 symbol with
# no version, which only loading the binary catches.

# `g++` rather than meo-skia-canvas's clang: their base, bare `almalinux:8`, has
# GCC 8.5 with no `<bit>` for Skia, where manylinux's default is GCC 14. This
# holds only while the base does.
ENV RUSTFLAGS="-C linker=g++ -C link-arg=-static-libstdc++"

ARG RUST=1.98.0
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST"
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src
