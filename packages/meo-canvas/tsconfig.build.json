{
  // Emits what the package publishes; the base config sets `noEmit`, since the
  // tests and the doc-example gate only typecheck.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // Both map kinds resolve because `src` ships beside `dist` (see `files`).
    // Maps without their sources would send every stack frame and declaration
    // lookup to a `../src/*.ts` missing from the tarball; `inlineSources` would
    // fix only the first, since TypeScript does not inline into `.d.ts.map`.
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/generated/doc-examples.ts"]
}
