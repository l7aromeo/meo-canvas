{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "target": "ES2022",
    "lib": ["ES2023"],
    // Node's, and only Node's. The package loads a native addon and writes
    // files, so it names `node:module` and `node:fs`; it deliberately does not
    // get `DOM`, so a library with no document cannot reach for `window`.
    "types": ["node"],

    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true
  },
  "exclude": ["src/**/*.test.ts"],
  "include": ["src"]
}
