{
  // The tests, which the shipped config excludes. They add `DOM`, where the
  // `AbortSignal`, `EventTarget` and timers Vitest's declarations name live, and
  // `rootDir` moves up so `../../fixtures/arena-cases.json` can be imported.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    // As in the base config: the boundary suite loads `meo-canvas.node` through
    // `createRequire` from `node:module`.
    "types": ["node"],
    "resolveJsonModule": true,
    "rootDir": "../.."
  },
  "exclude": [],
  "include": ["src", "../../fixtures/arena-cases.json"]
}
