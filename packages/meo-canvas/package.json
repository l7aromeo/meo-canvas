{
  "name": "meo-canvas",
  "version": "10.0.0-alpha.5",
  "description": "Declarative 2D scene rendering on Skia with CSS flexbox, grid and block layout.",
  "keywords": [
    "canvas",
    "server-side",
    "image-generation",
    "declarative",
    "skia",
    "layout",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ukasyah Rahmatullah Zada",
  "homepage": "https://l7aromeo.github.io/meo-canvas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-canvas/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@types/node": "^26.2.0"
  },
  "optionalDependencies": {
    "@meo-canvas/darwin-arm64": "10.0.0-alpha.5",
    "@meo-canvas/linux-arm64-gnu": "10.0.0-alpha.5",
    "@meo-canvas/linux-arm64-musl": "10.0.0-alpha.5",
    "@meo-canvas/linux-x64-gnu": "10.0.0-alpha.5",
    "@meo-canvas/linux-x64-musl": "10.0.0-alpha.5",
    "@meo-canvas/win32-arm64": "10.0.0-alpha.5",
    "@meo-canvas/win32-x64": "10.0.0-alpha.5"
  }
}
