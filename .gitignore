# Deny by default, at every depth. Nothing is tracked unless named below.
*

# Directories are re-included so git descends into them; their contents stay
# denied until a pattern below names them. A file cannot be re-included under
# an excluded directory, so this comes before every allow.
!*/

# -- Workspace root ---------------------------------------------------------
!/Cargo.toml
!/Cargo.lock
!/justfile
!/rust-toolchain.toml
!/rustfmt.toml
!/AGENTS.md
!/.gitignore
!/.gitattributes

# Outward-facing package documentation, which AGENTS.md is not: the README is
# what crates.io and npm render, and `clippy::cargo` requires the `readme` and
# `license` metadata that names these. Internal prose stays in AGENTS.md alone.
!/README.md

# -- Community health -------------------------------------------------------
# GitHub serves these from the default branch. Each is named because the `*`
# above refuses it, and a refused path fails to add in silence.
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/CONTRIBUTING.md
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/ISSUE_TEMPLATE/*.md
!/.github/FUNDING.yml
!/SUPPORT.md
# The v9 -> v10 migration guide, at the root and linked by absolute URL: the npm
# tarball does not ship it, so a relative link would 404 for its reader.
!/MIGRATING.md

# -- Brand ------------------------------------------------------------------
# The README banners and the script that draws them with meo-canvas itself.
# Not LFS: an animated banner is a few hundred kilobytes, and README images are
# fetched on every registry page view, which LFS meters.
!/tools/brand/**
!/docs/assets/brand/*.webp
!/docs/assets/brand/*.png
!/docs/assets/brand/README.md
!/LICENSE

# -- Release notes ----------------------------------------------------------
# One file per version per channel. The release workflows refuse to publish
# without the version's note, so it must be trackable; only `.md`, so a stray
# scratch file stays refused.
!/docs/releases/README.md
!/docs/releases/npm/*.md
!/docs/releases/rust/*.md

# -- Crates -----------------------------------------------------------------
# Each crate carries its own README because `clippy::cargo` requires the
# `readme` metadata and crates.io renders it per crate, not per workspace.
!/crates/*/Cargo.toml
!/crates/*/README.md
!/crates/**/*.rs

# What a test opens rather than constructs: a font a measurement needs, an
# image a decode reads. Scoped to `tests/assets` so a stray binary anywhere
# else in a crate stays denied.
!/crates/*/tests/assets/**

# -- TypeScript surface -----------------------------------------------------
!/packages/*/package.json
!/packages/*/tsconfig*.json
!/packages/*/README.md

# `cargo package` carries only files under the crate's directory, so each
# crate keeps its own copy of the licence text its `license` field claims.
!/crates/*/LICENSE

# The package manifest's `files` list names LICENSE, so the tarball npm
# publishes carries one rather than claiming MIT with nothing to show.
!/packages/*/LICENSE
!/packages/**/*.ts
!/packages/**/*.js
!/packages/**/*.mjs
# `*.ts` does not cover `*.d.mts`, which lets a typechecked file import a
# `.mjs` tool; without it a fresh clone fails `just typecheck`.
!/packages/**/*.d.mts

# The reference tool is its own package so it can pin the TypeScript TypeDoc
# loads. Each file it needs is named, since `git add -A` skips what this file
# denies.
!/packages/*/tools/typedoc/package.json
!/packages/*/tools/typedoc/bun.lock
!/packages/*/tools/typedoc/typedoc.json
!/packages/*/tools/typedoc/tsconfig.json
!/packages/*/tools/typedoc/README.md
!/packages/*/tools/typedoc/undocumented-baseline.txt
!/packages/*/tools/private-docs-baseline.txt

# The vendored tree's own licence, which MIT asks to travel with the code; kept
# beside it so it stays true if the vendored copy is dropped.
!/packages/*/vendor/LICENSE

# -- Formatter --------------------------------------------------------------
# The lockfile is tracked because `bun install --frozen-lockfile` reads it, in
# CI and in `ensure-deps`, and refuses to proceed when it and package.json
# disagree. `packageManager` in package.json names the bun version.
!/bun.lock
!/eslint.config.mjs
!/.prettierrc
!/.prettierignore

# The vitest config is the JavaScript coverage floor: thresholds, `all: true`
# and the generated-table exclusions. Without it `--coverage` still runs and
# passes while measuring nothing, so it is named rather than left to a pattern.
!/vitest.config.mts

# -- Golden fixtures --------------------------------------------------------
# Scenes and the images they must produce; the images are the assertion.
# `.mcs` is the persistence format, named for its `MCSC` magic; `.json` is a
# case written by hand.
!/fixtures/**/*.mcs
!/fixtures/**/*.json
!/fixtures/**/*.png

# -- Examples ---------------------------------------------------------------
# Consumer projects installed by link, so they exercise the package boundary.
# Their `out/` is denied below: `just example` compares it as it is written, so
# unlike a fixture image it asserts nothing once written.
!/examples/*/package.json
!/examples/*/tsconfig*.json
!/examples/**/*.ts
!/examples/**/*.mjs
!/examples/*/bun.lock
!/examples/*/Cargo.toml
!/examples/**/*.rs

# -- CI ---------------------------------------------------------------------
!/.github/workflows/*.yml
!/.github/dependabot.yml

# The Linux addons' build images, one per libc family, named by extension so
# adding a target needs no edit here.
!/containers/Dockerfile.*
!/containers/*.sh

# -- Build output and local configuration -----------------------------------
# Re-ignored after the allows so git prunes them rather than descending, as
# `!*/` would. `.cargo/` holds a local `[patch.crates-io]` to a sibling
# meo-skia-canvas checkout, which would break any clone without one.
target/
node_modules/
dist/
examples/*/out/
.cargo/
# What `just pack` writes, including a 51 MB binary. A release is built from a
# commit, never committed.
release/

# Local scratch output, never committed.
.tmp/
