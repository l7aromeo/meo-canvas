# Cargo's build output. Nothing here is written by hand.
target

# The compiled TypeScript surface, produced from packages/*/src.
dist

# Installed packages, formatted by whoever published them.
node_modules

# Golden scenes and their images. The JSON is machine-written, and reformatting
# it would bury the next real change in a rewrite of every fixture.
fixtures

# meo-skia-canvas's JavaScript layer, repointed at this binary and kept in that
# project's style. Formatting it would rewrite all 7,861 lines and ruin the
# diff against upstream, which is how fixes there are found and applied here.
packages/*/vendor

# Emitted by the generators (`just arena-tables` and its siblings), whose
# regenerate-and-diff checks would otherwise fail on formatting, not drift.
packages/*/src/generated

# Chrome measurement tables, written by `tools/conformance/` and read by the
# Rust tests. Machine-written, so excluded for the fixtures' reason.
crates/*/tests/assets

# Local scratch output, gitignored and never shipped.
.tmp
